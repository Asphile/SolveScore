# Database
DATABASE_URL=sqlite:///./solvescore.db

# Auth
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI content detection provider
# Set AI_PROVIDER=stub to use the built-in heuristic placeholder (no external calls).
# Set AI_PROVIDER=openai (or another supported provider) and supply AI_API_KEY to enable real detection.
AI_PROVIDER=stub
AI_API_KEY=

# File storage
FILE_STORAGE_PATH=./uploads
MAX_DOCUMENT_SIZE_MB=25
MAX_VIDEO_SIZE_MB=500

# CORS
# Comma-separate multiple allowed origins, e.g. when running a Cloudflare
# Pages/Vercel frontend alongside local dev:
# FRONTEND_ORIGIN=https://solvescore.pages.dev,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
